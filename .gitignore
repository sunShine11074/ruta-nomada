# ── Credenciales / claves — NUNCA versionar ──────────────────
# Cada archivo tiene su .sample versionado al lado, con instrucciones.
includes/mail_config.php
includes/geo_config.php
includes/ai_config.php
includes/maps_config.php

# ── Comprimidos — NUNCA versionar ────────────────────────────
# Las reglas de arriba miran nombres de archivo, no MIRAN DENTRO de un
# .zip. Un comprimido del proyecto se lleva includes/*_config.php con
# las claves reales aunque esos archivos esten ignorados sueltos, y en
# un repositorio publico eso las deja a la vista de cualquiera.
# Paso el 11/08/2026 con "RUTA NOMADA.zip": 50 MB con las cuatro claves
# dentro. Para compartir el proyecto se clona el repositorio; no se
# manda un comprimido.
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# ── Caché generada en tiempo de ejecución ────────────────────
cache/

# ── Dependencias ─────────────────────────────────────────────
# OJO: libs/ NO se ignora, y es a propósito.
#   · libs/dc/support.js lo carga plan.php desde el navegador; sin él
#     la vista del plan sale en blanco.
#   · libs/PHPMailer es la librería de correo, copiada a mano porque
#     el proyecto no usa Composer.
# Como no hay "composer install" que las reponga, tienen que viajar
# dentro del repo o quien lo clone recibe una app rota.
vendor/
node_modules/

# ── Sistema operativo / editor ───────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
.claude/

# ── Archivos temporales de pruebas ───────────────────────────
smoke_test.php
*.bak
*~
